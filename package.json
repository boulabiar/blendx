{
  "name": "blendx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "import": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build:native": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j",
    "build:types": "bun x tsc -p tsconfig.json",
    "build": "bun run build:native && bun run build:types",
    "example": "bun run build:native && bun examples/counter.tsx",
    "stress": "bun run build:native && bun examples/stress.tsx",
    "chat": "bun run build:native && bun examples/chat.tsx",
    "chat:benchmark": "bun run build:native && bun examples/chat.tsx --headless",
    "benchmark": "bun run build:native && bun examples/stress.tsx --headless",
    "compile:chat": "bun run build:native && bun build --compile --minify examples/chat.tsx --outfile build/blendx-chat",
    "test": "bun run build && bun test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-reconciler": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
